[Unit]
Description=BeaconSentry - Autonomous C2 Beacon Detection & Active iptables Quarantine Service
Documentation=https://github.com/BeaconSentry/BeaconSentry
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/beaconsentry
ExecStart=/usr/local/bin/beaconsentry --daemon -q --log-dir /var/log/beaconsentry
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beaconsentry

# Security & Sandboxing Capabilities
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
